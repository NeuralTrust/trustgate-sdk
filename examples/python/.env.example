# Copy to .env and fill in. Nothing here is read from a real gateway until you do.

# Your gateway's MCP host, and nothing after it. The Connect tab of any
# application shows the full endpoint — https://<your-gateway>.<mcp-domain>/<application>/mcp
# — and this is that URL with the /<application>/mcp cut off. The LLM plane is
# a different host; the SDK asks the gateway for that one itself.
TRUSTGATE_URL=https://<your-gateway>.<your-mcp-domain>

# The application's API key. Issued from the Authentication block of its
# General tab, and shown once.
TRUSTGATE_API_KEY=<your-trustgate-api-key>

# Only end_user_agent.py needs this one: it calls Anthropic directly.
# batch.py needs no model key at all.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional. Set these only when one key reaches more than one consumer of the
# same plane — the SDK then says so and asks which.
# TRUSTGATE_MCP_CONSUMER=
# TRUSTGATE_LLM_CONSUMER=
